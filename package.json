{
  "name": "dsh-playbook",
  "version": "0.1.1",
  "description": "Expert playbook engine with executable stages, quality gates, retries, branching, and tool policy for DeepSeek Harness",
  "type": "module",
  "main": "./src/plugin.js",
  "exports": {
    ".": "./src/plugin.js",
    "./client": "./lib/client.js",
    "./core": "./src/core.js",
    "./engine": "./src/engine.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.js",
    "lib/client.js",
    "examples/*.json",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check src/core.js && node --check src/engine.js && node --check src/catalog.js && node --check src/state.js && node --check src/builtins.js && node --check src/index.js && node --check src/plugin.js && node --check lib/client.js",
    "packcheck": "npm pack --dry-run --json"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rffanlab/dsh-playbook.git"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "playbook",
    "workflow",
    "sop",
    "agent",
    "quality-gate"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
